<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <Button
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:backgroundTint="@color/card"
            android:contentDescription="@string/back"
            android:text="‹"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/brand_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:letterSpacing="0.04"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/brand_accent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Gaming and esports arena"
            android:text="●"
            android:textColor="@color/electric_blue"
            android:textSize="18sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/screen_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/screen_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/nav_home"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:contentDescription="@string/home"
            android:text="Home"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="11sp" />

        <Button
            android:id="@+id/nav_packages"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:contentDescription="@string/packages"
            android:text="Packages"
            android:textAllCaps="false"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <Button
            android:id="@+id/nav_experiences"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:contentDescription="@string/experiences"
            android:text="Play"
            android:textAllCaps="false"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <Button
            android:id="@+id/nav_calculator"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:contentDescription="@string/calculate_fees"
            android:text="Fees"
            android:textAllCaps="false"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <Button
            android:id="@+id/nav_contact"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:contentDescription="@string/contact"
            android:text="Contact"
            android:textAllCaps="false"
            android:textColor="@color/muted"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
