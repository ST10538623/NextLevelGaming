<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/offering_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_background"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/offering_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/offering_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/muted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/offering_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:contentDescription="Offering price in South African rand"
        android:textColor="@color/electric_blue"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
